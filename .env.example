# OBLIGATORIO:

# Copiar este archivo como .env y completar los valores.
CATALOGO_DB_NAME=catalogo
CATALOGO_DB_USER=catalogo
CATALOGO_DB_PASSWORD=
CATALOGO_DB_PORT=5433

# Cuenta técnica de la cátedra. Si falta alguna, el servicio arranca con un warning y sin integración con la cátedra.
CATALOGO_CATEDRA_BASE_URL=
CATALOGO_CATEDRA_USERNAME=
CATALOGO_CATEDRA_PASSWORD=

# ---------------------------------------

# OPCIONALES, EL VALOR QUE ESTA ESTABLECIDO DE EJEMPLO ES EL VALOR POR DEFECTO.

# Opcional: puerto en el que escucha el servicio. El 8080 lo usa el servicio de turnos por defecto.
# CATALOGO_PORT=8081
