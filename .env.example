# OBLIGATORIO:

# Copiar este archivo como .env y completar los valores.
CATALOGO_DB_NAME=catalogo
CATALOGO_DB_USER=catalogo
CATALOGO_DB_PASSWORD=
CATALOGO_DB_PORT=5433

# Cuenta técnica de la cátedra. Si falta alguna, el servicio arranca con un warning y sin integración con la cátedra.
CATALOGO_CATEDRA_BASE_URL=
CATALOGO_CATEDRA_USERNAME=
CATALOGO_CATEDRA_PASSWORD=

# Clave pública del JWT del servicio de turnos. La ubicación del archivo PEM, con el prefijo file. Obligatorio para habilitar comunicacion con turnos.
CATALOGO_JWT_PUBLIC_KEY_LOCATION=

# Solo para el E2E de Kafka, la aplicación no la lee: el consumer group con el que lee el test.
# Tiene que terminar en -e2e, para que nunca sea el del servicio. Sin ella, ese E2E se saltea.
# CATALOGO_E2E_KAFKA_CONSUMER_GROUP=

# ---------------------------------------

# OPCIONALES, EL VALOR QUE ESTA ESTABLECIDO DE EJEMPLO ES EL VALOR POR DEFECTO.

# Opcional: puerto en el que escucha el servicio. El 8080 lo usa el servicio de turnos por defecto.
# CATALOGO_PORT=8081

# Opcional: orígenes de navegador que pueden usar la API, exactos y separados por comas. Vacía, ningún navegador.
# CATALOGO_CORS_ALLOWED_ORIGINS=

# Opcionales: tiempos y reintentos con la cátedra. Duraciones con el formato de Spring: 500ms, 5s, 2m.
# Una duración vacía toma el valor por defecto. Un número (intentos o multiplicador) vacío no: la aplicación no
# arranca. Si no se quiere cambiar, dejar la línea comentada.

# Login técnico: timeouts, reintentos y mínimo entre dos logins.
# CATALOGO_CATEDRA_CONNECT_TIMEOUT=5s
# CATALOGO_CATEDRA_READ_TIMEOUT=10s
# CATALOGO_CATEDRA_LOGIN_MAX_ATTEMPTS=5
# CATALOGO_CATEDRA_LOGIN_INITIAL_DELAY=1s
# CATALOGO_CATEDRA_LOGIN_MULTIPLIER=2
# CATALOGO_CATEDRA_LOGIN_MAX_DELAY=30s
# CATALOGO_CATEDRA_LOGIN_MIN_INTERVAL=60s

# Cuánto espera la verificación del arranque al login técnico inicial, y cada cuánto lo consulta.
# CATALOGO_CATEDRA_INITIAL_LOGIN_MAX_WAIT=2m
# CATALOGO_CATEDRA_INITIAL_LOGIN_POLL_INTERVAL=200ms

# Pedido del snapshot del catálogo: timeouts y reintentos.
# CATALOGO_CATEDRA_SNAPSHOT_CONNECT_TIMEOUT=5s
# CATALOGO_CATEDRA_SNAPSHOT_READ_TIMEOUT=10s
# CATALOGO_CATEDRA_SNAPSHOT_MAX_ATTEMPTS=5
# CATALOGO_CATEDRA_SNAPSHOT_INITIAL_DELAY=1s
# CATALOGO_CATEDRA_SNAPSHOT_MULTIPLIER=2
# CATALOGO_CATEDRA_SNAPSHOT_MAX_DELAY=30s

# Redis de la cátedra: timeout para conectar, timeout de cada comando y reintentos de cada lectura. Los datos de
# conexión llegan con el login técnico.
# CATALOGO_CATEDRA_REDIS_CONNECT_TIMEOUT=5s
# CATALOGO_CATEDRA_REDIS_COMMAND_TIMEOUT=2s
# CATALOGO_CATEDRA_REDIS_MAX_ATTEMPTS=3
# CATALOGO_CATEDRA_REDIS_INITIAL_DELAY=1s
# CATALOGO_CATEDRA_REDIS_MULTIPLIER=2
# CATALOGO_CATEDRA_REDIS_MAX_DELAY=30s

# Kafka de la cátedra: los avisos de versión nueva del catálogo. Los servidores, el topic y el consumer group llegan con el login técnico.
# CATALOGO_CATEDRA_KAFKA_ENABLED=true
# CATALOGO_CATEDRA_KAFKA_MAX_POLL_INTERVAL=10m

# Opcional: enciende o apaga la verificación periódica de la versión del catálogo. Vacía, la apaga.
# CATALOGO_VERIFICATION_ENABLED=true

# Opcional: cuánto se espera entre el fin de una verificación y el comienzo de la siguiente. La primera corre al
# arrancar. Para una demo se puede bajar, por ejemplo a 30s. Vacía: la aplicación no arranca.
# CATALOGO_VERIFICATION_INTERVAL=5m

# Opcionales: reintentos cuando la base falla al aplicar una versión del catálogo.
# CATALOGO_VERIFICATION_PERSISTENCE_MAX_ATTEMPTS=3
# CATALOGO_VERIFICATION_PERSISTENCE_INITIAL_DELAY=1s
# CATALOGO_VERIFICATION_PERSISTENCE_MULTIPLIER=2
# CATALOGO_VERIFICATION_PERSISTENCE_MAX_DELAY=30s
